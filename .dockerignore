# Local Python environment, bytecode and tool caches
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Git metadata is not needed to run in the container.
.git/

# Personal configuration is passed to the container at run time.
.env
.env.*
*.local.yaml
*.local.yml
profile.yaml

# Local run data and temporary analyses do not belong in the image.
data/
tmp/

# Terraform configuration and local state files do not belong in the image.
infrastructure/
