# Lokale Python-Umgebung, Bytecode und Werkzeug-Caches
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Persönliche Konfiguration; die gemeinsame .env.example bleibt versioniert.
profile.yaml
*.local.yaml
*.local.yml
.env
.env.*
!.env.example

# Laufzeitdaten, lokale Datenbanken, Logs und temporäre Auswertungen
data/
tmp/
*.log
*.sqlite
*.sqlite3
*.db

# Lokale Schlüssel und Zertifikate
*.pem
*.key
*.p12
*.pfx

# Lokale Bewerbungsunterlagen und andere Dokumentdateien
*.pdf
*.doc
*.docx
*.odt
*.rtf

# Lokale Terraform-Downloads und Zustandsdateien
**/.terraform/
*.tfstate
*.tfstate.*

# Lokale Eingabewerte und gespeicherte Ausführungspläne
*.tfvars
*.tfvars.json
*.tfplan

# Terraform-Quellcode (.tf) und .terraform.lock.hcl bleiben versioniert.
