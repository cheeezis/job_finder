# Local Python environment, bytecode and tool caches
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Personal configuration; the shared .env.example stays versioned.
profile.yaml
*.local.yaml
*.local.yml
.env
.env.*
!.env.example

# Run data, local databases, logs and temporary analyses
data/
tmp/
# Eval cases and results from the own review: profile, notes, real listings
evals/private/
# Raw data of the eval runs with all fact sheets; the Markdown report is the readable one.
evals/results/*.json
*.log
*.sqlite
*.sqlite3
*.db

# Local keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local application documents and other document files
*.pdf
*.doc
*.docx
*.odt
*.rtf

# Local Terraform downloads and state files
**/.terraform/
*.tfstate
*.tfstate.*

# Local input values and saved execution plans
*.tfvars
*.tfvars.json
*.tfplan

# Terraform source code (.tf) and .terraform.lock.hcl stay versioned.

# Type check tools (npm ci) and the intermediate file of npm run types:api
node_modules/
openapi.json
